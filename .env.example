# DMR — контракт переменных окружения (docs/hostinger-deployment.md §3).
# Значения НИКОГДА не коммитятся. Локально копировать в .env.

# --- База данных (Neon) ---
# Pooled-соединение для runtime-запросов приложения.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dmr?sslmode=require"
# Direct-соединение для миграций/интроспекции.
DIRECT_DATABASE_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dmr?sslmode=require"

# --- Приложение ---
NODE_ENV="development"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Аутентификация персонала ---
# Минимум 32 символа. Генерация: openssl rand -base64 48
STAFF_SESSION_SECRET="change-me-min-32-characters-long-secret-value"

# --- Stripe (используется с Этапа 4; на Этапе 1 можно оставить пустым) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Media storage (провайдер — открытый вопрос Этапа 0) ---
# local — только для разработки; production требует object storage/CDN.
MEDIA_STORAGE_PROVIDER="local"
MEDIA_STORAGE_BUCKET=""
MEDIA_STORAGE_REGION=""
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
MEDIA_STORAGE_PUBLIC_BASE_URL=""

# --- Cron (fail-closed: без секрета эндпоинт отвечает 503) ---
CRON_SECRET=""

# --- Сид (только для локальной разработки) ---
SEED_OWNER_EMAIL="owner@dmr.local"
SEED_OWNER_PASSWORD="ChangeMe!Dev1234"
